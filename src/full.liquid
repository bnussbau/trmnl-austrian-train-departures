{% assign walk_minutes = trmnl.plugin_settings.custom_fields_values.walk_minutes | default: 0 %}
{% assign walk_seconds = walk_minutes | times: 60 %}
{% assign cutoff = "now" | date: '%s' | plus: walk_seconds %}
<div class="layout layout--top">
  <div class="stretch">
    <table class="table" >
      <thead>
        <tr>
          <th><span class="title title--small lg:title--base">Plan</span></th>
          <th><span class="title title--small lg:title--base">Aktuell</span></th>
          <th><span class="title title--small lg:title--base">Zug</span></th>
          <th><span class="title title--small lg:title--base">Ziel</span></th>
          <th><span class="title title--small lg:title--base">Steig</span></th>
        </tr>
      </thead>
      <tbody>
        {% for departure in departures %}
        {% assign effective_time = departure.scheduledTime %}
        {% if departure.time != null and departure.time != 0 %}
        {% assign effective_time = departure.time %}
        {% endif %}
        {% if effective_time >= cutoff %}
        {% assign cancelled = false %}
        {% if departure.isCancelled %}
        {% assign cancelled = true %}
        {% endif %}
        <tr>
          <td>
            <span class="label{% if cancelled %} text--red{% endif %}">{{ departure.scheduledTime | plus: trmnl.user.utc_offset | date: "%H:%M" }}</span>
          </td>
          <td>
            {% if cancelled %}
            <span class="label label--error ">Ausfall</span>
            {% elsif departure.delay != null and departure.delay != 0 %}
            <span class="label">{{ departure.time | plus: trmnl.user.utc_offset | date: "%H:%M" }}</span>
            {% else %}
            <span class="label"></span>
            {% endif %}
          </td>
          <td><span class="label {% if cancelled %} text--red{% endif %}">{{ departure.train }}</span></td>
          <td><span class="label {% if cancelled %} text--red{% endif %}" data-clamp="1">{{ departure.destination }}</span></td>
          <td>
            {% if cancelled %}
            <span class="label  text--red">-</span>
            {% elsif departure.scheduledPlatform != departure.platform %}
            <span class="label  bg--yellow text--black">{{ departure.platform }}</span>
            {% else %}
            <span class="label ">{{ departure.platform }}</span>
            {% endif %}
          </td>
        </tr>
        {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ plugin_logo | base64_encode }}" alt="" />
  <span class="title">{{ trmnl.plugin_settings.custom_fields_values.db_station }} Abfahrten | Station: {{ trmnl.plugin_settings.custom_fields_values.oebb_station | url_decode }}</span>
  <span class="instance">Aktualisiert: {{ "now" | date: '%s' | plus: trmnl.user.utc_offset | date: "%Y-%m-%d %H:%M" }}</span>
</div>
